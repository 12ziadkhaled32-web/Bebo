# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Obtain from Google Analytics -> Admin -> Data Streams -> Web -> Measurement ID.
VITE_GA_MEASUREMENT_ID=""

# VITE_FIREBASE_VAPID_KEY: Web Push certificate public key (VAPID) for Firebase Cloud Messaging.
# Obtain from Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration.
VITE_FIREBASE_VAPID_KEY=""

# ADMIN_PORTAL_PASSCODE: Server-side passcode protecting access to the Admin Portal UI.
# Set this secret in AI Studio Settings -> Secrets before sharing or deploying.
ADMIN_PORTAL_PASSCODE=

# CAMP_EXAM_PANEL_PASSCODE: Optional server-side override for the in-camp exam creator passcode.
# Leave unset to use the default hashed credential verified on the server.
CAMP_EXAM_PANEL_PASSCODE=

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: Server-side ECDSA P-256 keys for W3C Web Push.
# Generate once with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY exclusively on the server (AI Studio Secrets).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

