{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe student profile storing display name, chosen avatar, and active camp reference.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "avatarUrl": { "type": "string", "minLength": 1, "maxLength": 40000 },
        "campId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20, "pattern": "^\\+201[0125][0-9]{8}$" },
        "groupCampId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "avatarUrl", "campId", "createdAt", "updatedAt"]
    },
    "PhoneLoginAlias": {
      "title": "PhoneLoginAlias",
      "description": "Opaque auth-email pointer and non-sensitive security question label for SMS-free phone+password login and recovery.",
      "type": "object",
      "properties": {
        "phoneDigits": { "type": "string", "pattern": "^201[0125][0-9]{8}$" },
        "authEmail": { "type": "string", "maxLength": 120 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "securityQuestion": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phoneDigits", "authEmail", "ownerUid", "securityQuestion", "updatedAt"]
    },
    "PhoneRecoverySecret": {
      "title": "PhoneRecoverySecret",
      "description": "Non-readable SHA-256 security answer hash vault used to authorize SMS-free password reset.",
      "type": "object",
      "properties": {
        "phoneDigits": { "type": "string", "pattern": "^201[0125][0-9]{8}$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "secretHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "proofHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phoneDigits", "ownerUid", "secretHash", "proofHash", "updatedAt"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "description": "Unique invite code lookup mapping a short code to a 2-student study camp.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "campName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "isFull": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "campId", "ownerUid", "campName", "isFull", "createdAt", "updatedAt"]
    },
    "Camp": {
      "title": "Camp",
      "description": "20-day closed study camp strictly shared between at most two students.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "inviteCode": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "member1Uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "member1Name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "member1Avatar": { "type": "string", "minLength": 1, "maxLength": 40000 },
        "member1LastActivity": { "type": "string", "maxLength": 160 },
        "member1LastActiveAt": { "type": "string", "format": "date-time" },
        "member1StudyMinutes": { "type": "integer" },
        "member2Uid": { "type": "string", "maxLength": 128 },
        "member2Name": { "type": "string", "maxLength": 50 },
        "member2Avatar": { "type": "string", "maxLength": 40000 },
        "member2LastActivity": { "type": "string", "maxLength": 160 },
        "member2LastActiveAt": { "type": "string", "format": "date-time" },
        "member2StudyMinutes": { "type": "integer" },
        "memberCount": { "type": "integer" },
        "startDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "heroImageUrl": { "type": "string", "maxLength": 60000 },
        "status": { "type": "string", "enum": ["waiting", "active", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "name", "inviteCode", "ownerUid",
        "member1Uid", "member1Name", "member1Avatar", "member1LastActivity", "member1LastActiveAt", "member1StudyMinutes",
        "member2Uid", "member2Name", "member2Avatar", "member2LastActivity", "member2LastActiveAt", "member2StudyMinutes",
        "memberCount", "startDate", "status", "createdAt", "updatedAt"
      ]
    },
    "CampTask": {
      "title": "CampTask",
      "description": "Study task on a specific day (1..20) with dual independent completion flags for both students.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "day": { "type": "integer" },
        "subject": { "type": "string", "enum": ["arabic", "english", "biology", "chemistry", "physics", "math", "history", "geography", "statistics", "geology"] },
        "taskType": { "type": "string", "enum": ["watch_lecture", "study_lecture", "solve_homework", "solve_questions", "revision", "comprehensive_exam", "custom"] },
        "customTypeLabel": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "notes": { "type": "string", "maxLength": 400 },
        "bgImageUrl": { "type": "string", "maxLength": 60000 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "member1Done": { "type": "boolean" },
        "member1DoneAtMs": { "type": "integer" },
        "member2Done": { "type": "boolean" },
        "member2DoneAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "campId", "day", "subject", "taskType", "customTypeLabel", "title", "notes",
        "createdBy", "member1Done", "member1DoneAtMs", "member2Done", "member2DoneAtMs", "createdAt", "updatedAt"
      ]
    },
    "CampMessage": {
      "title": "CampMessage",
      "description": "Encouragement message exchanged between the two camp partners.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "senderAvatar": { "type": "string", "minLength": 1, "maxLength": 40000 },
        "type": { "type": "string", "enum": ["normal", "advice", "dua", "quote", "love", "custom"] },
        "customLabel": { "type": "string", "maxLength": 40 },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "isBanner": { "type": "boolean" },
        "parentMessageId": { "type": "string", "maxLength": 128 },
        "partnerReaction": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campId", "senderUid", "senderName", "senderAvatar", "type", "customLabel", "content", "isBanner", "createdAt"]
    },
    "CampSurprise": {
      "title": "CampSurprise",
      "description": "Virtual gift or celebration card sent from one partner to the other.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "kind": { "type": "string", "enum": ["rose", "heart", "star", "congrats", "medal", "surprise_note"] },
        "note": { "type": "string", "maxLength": 400 },
        "opened": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campId", "senderUid", "senderName", "recipientUid", "kind", "note", "opened", "createdAt", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Completed Pomodoro study session logged by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subject": { "type": "string", "enum": ["arabic", "english", "biology", "chemistry", "physics", "math", "history", "geography", "statistics", "geology", "general"] },
        "durationMinutes": { "type": "integer" },
        "day": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campId", "userUid", "subject", "durationMinutes", "day", "createdAt"]
    },
    "CampNotification": {
      "title": "CampNotification",
      "description": "Real-time notification event inside a study camp.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["lecture_done", "task_completed", "new_message", "new_question", "new_surprise", "new_day", "camp_ending"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 240 },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campId", "actorUid", "targetUid", "type", "title", "body", "readBy", "createdAt", "updatedAt"]
    },
    "LittleQuestion": {
      "title": "LittleQuestion",
      "description": "Cute crystalline text or photo question shared between the two camp partners with replies and emoji reactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "senderAvatar": { "type": "string", "minLength": 1, "maxLength": 40000 },
        "crystalStyle": { "type": "string", "enum": ["toty_sapphire", "rose_quartz", "starlight_gold", "aurora_amethyst"] },
        "content": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 90000 },
        "parentQuestionId": { "type": "string", "maxLength": 128 },
        "partnerReaction": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campId", "senderUid", "senderName", "senderAvatar", "crystalStyle", "content", "imageUrl", "createdAt"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Owner-only Web Push FCM registration token bound to a student UID, device, and active camp.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "maxLength": 128 },
        "token": { "type": "string", "minLength": 20, "maxLength": 512 },
        "platform": { "type": "string", "enum": ["web"] },
        "deviceLabel": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "campId", "token", "platform", "deviceLabel", "active", "createdAt", "updatedAt", "lastUsedAt"]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "Owner-only per-category push notification settings respected by Cloud Functions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "enabled": { "type": "boolean" },
        "lecture_done": { "type": "boolean" },
        "task_completed": { "type": "boolean" },
        "new_message": { "type": "boolean" },
        "new_question": { "type": "boolean" },
        "new_surprise": { "type": "boolean" },
        "new_day": { "type": "boolean" },
        "camp_ending": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "enabled", "lecture_done", "task_completed",
        "new_message", "new_question", "new_surprise", "new_day", "camp_ending", "updatedAt"
      ]
    },
    "GroupInviteCode": {
      "title": "GroupInviteCode",
      "description": "Unique invite code lookup mapping a short code to an admin-created Group Camp (up to 50 students).",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "campId", "createdAt", "updatedAt"]
    },
    "GroupCamp": {
      "title": "GroupCamp",
      "description": "Group study camp hosting up to 50 students with competitive exams and leaderboard.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "coverImageUrl": { "type": "string", "maxLength": 180000 },
        "coverStoragePath": { "type": "string", "maxLength": 300 },
        "maxMembers": { "type": "integer", "minimum": 1, "maximum": 50 },
        "memberCount": { "type": "integer", "minimum": 0, "maximum": 50 },
        "inviteCode": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "coverImageUrl", "coverStoragePath", "maxMembers", "memberCount", "inviteCode", "status", "createdByUid", "createdAt", "updatedAt"]
    },
    "GroupCampMember": {
      "title": "GroupCampMember",
      "description": "Student membership and independent leaderboard stats inside a Group Camp.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "avatarUrl": { "type": "string", "maxLength": 40000 },
        "totalScore": { "type": "number", "minimum": 0 },
        "examsTakenCount": { "type": "integer", "minimum": 0 },
        "totalCorrectAnswers": { "type": "integer", "minimum": 0 },
        "totalQuestionsAnswered": { "type": "integer", "minimum": 0 },
        "completionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "lastExamScore": { "type": "number", "minimum": 0 },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "campId", "displayName", "avatarUrl", "totalScore", "examsTakenCount", "totalCorrectAnswers", "totalQuestionsAnswered", "completionPercent", "lastExamScore", "joinedAt", "updatedAt"]
    },
    "GroupExam": {
      "title": "GroupExam",
      "description": "Scheduled electronic competitive exam created by admin inside a Group Camp.",
